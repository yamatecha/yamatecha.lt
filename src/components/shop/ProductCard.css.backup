/* Modern ProductCard Styles - Override global styles */

/* Force modern styles and override legacy CSS */
.bg-white.rounded-lg.shadow-md.overflow-hidden,
.bg-white.rounded-2xl.shadow-lg.overflow-hidden {
  border-radius: 1rem !important;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
  border: 1px solid #f3f4f6 !important;
  transition: all 0.5s ease !important;
}

.bg-white.rounded-lg.shadow-md.overflow-hidden:hover,
.bg-white.rounded-2xl.shadow-lg.overflow-hidden:hover {
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15) !important;
  transform: translateY(-8px) !important;
}

/* Override model-card styles that might be applied */
.model-card {
  border-radius: 1rem !important;
  overflow: hidden !important;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
  transition: all 0.5s ease !important;
  border: 1px solid #f3f4f6 !important;
}

.model-card:hover {
  transform: translateY(-8px) !important;
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15) !important;
}

/* Override specific el-dviraciai page styles */
.el-dviraciai .models-grid .bg-white.rounded-lg.shadow-md.overflow-hidden,
.el-dviraciai .models-grid .bg-white.rounded-2xl.shadow-lg.overflow-hidden {
  border-radius: 1rem !important;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1) !important;
  border: 1px solid #f3f4f6 !important;
  transition: all 0.5s ease !important;
  transform: none !important;
}

.el-dviraciai .models-grid .bg-white.rounded-lg.shadow-md.overflow-hidden:hover,
.el-dviraciai .models-grid .bg-white.rounded-2xl.shadow-lg.overflow-hidden:hover {
  box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15) !important;
  transform: translateY(-8px) !important;
}

/* Ensure aspect ratio works */
.aspect-square {
  aspect-ratio: 1 / 1 !important;
  overflow: hidden !important;
}

/* Image hover effects */
.aspect-square img {
  transition: transform 0.7s ease !important;
}

.aspect-square:hover img {
  transform: scale(1.1) !important;
}

/* Button styles override */
.bg-yamaha-red {
  background-color: #dc2626 !important;
}

.bg-yamaha-red:hover {
  background-color: #b91c1c !important;
}

.bg-yamaha-blue {
  background-color: #1e40af !important;
}

.bg-yamaha-blue:hover {
  background-color: #1e3a8a !important;
}

/* Ensure proper spacing and layout */
.p-4,
.p-5 {
  padding: 1.25rem !important;
}

.space-y-4 > * + * {
  margin-top: 1rem !important;
}

/* Badge styles */
.rounded-full {
  border-radius: 9999px !important;
}

/* Animation classes */
.transition-all {
  transition-duration: 300ms !important;
}

.transition-transform {
  transition-duration: 300ms !important;
}

/* Group hover effects */
.group:hover .group-hover\:text-yamaha-blue {
  color: #1e40af !important;
}

/* Scale animations */
.hover\:scale-110:hover {
  transform: scale(1.1) !important;
}

.hover\:scale-105:hover {
  transform: scale(1.05) !important;
}

/* Translate animations */
.hover\:-translate-y-2:hover {
  transform: translateY(-8px) !important;
}

.hover\:-translate-y-0\.5:hover {
  transform: translateY(-2px) !important;
}

/* Shadow animations */
.hover\:shadow-2xl:hover {
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
}

.hover\:shadow-lg:hover {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
}

.hover\:shadow-md:hover {
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06) !important;
}

/* Text color utilities */
.text-yamaha-red {
  color: #dc2626 !important;
}

.text-yamaha-blue {
  color: #1e40af !important;
}

/* Background utilities */
.bg-gray-100 {
  background-color: #f3f4f6 !important;
}

.bg-gray-200:hover {
  background-color: #e5e7eb !important;
}

/* Override any conflicting legacy styles */
.model-info {
  padding: 1.25rem !important;
}

.model-btn {
  border-radius: 0.75rem !important;
  padding: 0.75rem 1rem !important;
  font-weight: 600 !important;
  transition: all 0.3s ease !important;
}

.model-btn:hover {
  transform: translateY(-2px) !important;
}

/* Ensure proper responsive behavior */
@media (max-width: 768px) {
  .models-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)) !important;
    gap: 1rem !important;
    padding: 1rem !important;
  }
}

@media (max-width: 480px) {
  .models-grid {
    grid-template-columns: 1fr !important;
    gap: 0.75rem !important;
    padding: 0.75rem !important;
  }
}
